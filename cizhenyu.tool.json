{
  "protocolVersion": 1,
  "id": "bing-webmaster",
  "name": "Bing Webmaster Tools",
  "category": "seo",
  "tier": "optional",
  "description": "Bing sites, URL submission, and crawl stats",
  "source": {
    "github": "https://github.com/youcizi-art/cizhenyu_bing_webmaster",
    "defaultRef": "master"
  },
  "install": {
    "runtime": "python",
    "steps": [],
    "readyCheck": [
      "server.py"
    ]
  },
  "credentials": {
    "key": "bing",
    "fields": [
      {
        "type": "password",
        "name": "apiKey",
        "label": "API Key",
        "required": true,
        "tip": "Bing Webmaster → Settings → API Access",
        "link": {
          "label": "Bing Webmaster Tools",
          "url": "https://www.bing.com/webmasters"
        }
      }
    ],
    "sidecar": "bing.json"
  },
  "env": [
    {
      "name": "BING_WEBMASTER_API_KEY",
      "fromCredential": "apiKey"
    },
    {
      "name": "CIZHENYU_AUTH_DIR",
      "from": "credentialsDir"
    }
  ],
  "mcp": {
    "transport": "stdio",
    "command": "python",
    "args": [
      "server.py"
    ],
    "cwd": "."
  },
  "guides": {
    "setup": "guides/setup.md",
    "setupByLocale": {
      "zh-CN": "guides/setup.md",
      "zh": "guides/setup.md",
      "en": "guides/setup.en.md",
      "en-US": "guides/setup.en.md"
    }
  },
  "health": {
    "requireCredentials": true,
    "requireReadyFiles": [
      "server.py"
    ]
  },
  "actions": [],
  "defaultLocale": "en",
  "i18n": {
    "zh-CN": {
      "description": "Bing 站点、URL 提交与抓取统计",
      "fields": {
        "apiKey": {
          "tip": "Bing Webmaster → 设置 → API 访问",
          "linkLabel": "Bing Webmaster Tools"
        }
      }
    }
  }
}
